# Copy to `.env` and adjust. Every value is optional.

# Environment profile from src/config/environments.ts (production | staging)
TEST_ENV=production
# Override the storefront URL of the selected profile
# BASE_URL=https://sauce-demo.myshopify.com

# Browser behaviour
HEADLESS=true
SLOWMO=0
# chromium (default) | all  -> chromium, firefox, webkit, mobile-chrome
BROWSERS=chromium
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=900

# Execution
# WORKERS=3
# RETRIES=1

# Evidence: on | off | retain-on-failure | on-first-retry
VIDEO=retain-on-failure
TRACE=retain-on-failure
# on | off | only-on-failure
SCREENSHOT=only-on-failure
CHECKPOINT_SCREENSHOTS=true

# Reporting
# Console echo level (the full log is always attached to Allure): debug | info | warn | error
LOG_LEVEL=warn
# true = also show Playwright API calls / expect() as Allure steps
ALLURE_DETAIL=false
# false = skip the intentionally failing/broken showcase tests (green CI runs)
SHOWCASE_FAILURES=true
