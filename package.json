{
  "name": "playwright-allure-showcase",
  "version": "1.0.0",
  "description": "Production-ready Playwright + TypeScript framework demonstrating advanced Allure Report capabilities against the Sauce Demo Shopify store.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "cross-env HEADLESS=false playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all-browsers": "cross-env BROWSERS=all playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test src/tests/auth",
    "test:products": "playwright test src/tests/products",
    "test:cart": "playwright test src/tests/cart",
    "test:checkout": "playwright test src/tests/checkout",
    "test:showcase": "playwright test src/tests/showcase",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:debug": "cross-env HEADLESS=false PWDEBUG=1 playwright test --workers=1",
    "allure:prepare": "tsx scripts/prepare-allure.ts",
    "allure:generate": "tsx scripts/generate-report.ts",
    "allure:open": "tsx scripts/allure.ts open allure-report",
    "allure:serve": "npm run allure:prepare && tsx scripts/allure.ts serve allure-results",
    "allure:single-file": "tsx scripts/generate-report.ts --single-file",
    "report": "npm run allure:generate && npm run allure:open",
    "test:report": "tsx scripts/run-and-report.ts",
    "trend:demo": "tsx scripts/trend-demo.ts",
    "clean": "rimraf allure-results allure-report test-results playwright-report",
    "clean:results": "rimraf allure-results test-results",
    "clean:all": "rimraf allure-results allure-report allure-history test-results playwright-report",
    "typecheck": "tsc --noEmit",
    "docker:test": "docker compose run --rm tests",
    "docker:report": "docker compose up report",
    "docs:screenshots": "tsx scripts/docs/capture-screenshots.ts",
    "docs:pdf": "tsx scripts/docs/build-pdf.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
